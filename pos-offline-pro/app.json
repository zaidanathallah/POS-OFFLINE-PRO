{
  "expo": {
    "name": "POS Offline PRO",
    "slug": "pos-offline-pro",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "posofflinepro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.paditechsolutions.posofflinepro",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Izinkan POS Offline PRO mengakses kamera untuk scan barcode dan QR produk.",
        "NSPhotoLibraryUsageDescription": "Izinkan POS Offline PRO mengakses galeri untuk memilih logo toko atau gambar produk."
      }
    },
    "android": {
      "package": "com.paditechsolutions.posofflinepro",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan POS Offline PRO mengakses kamera untuk scan barcode dan QR produk."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc16a892-d276-49de-ba05-4994b1f89d40"
      }
    },
    "owner": "padisolutionsgroup"
  }
}
